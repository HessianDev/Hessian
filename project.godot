[physics]

common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=16
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics (Extension)"
jolt_physics_3d/simulation/velocity_steps=20
jolt_physics_3d/simulation/position_steps=16
jolt_physics_3d/simulation/baumgarte_stabilization_factor=0.9
3d/sleep_threshold_linear=0.05
3d/sleep_threshold_angular=0.00174532925199432
3d/solver/solver_iterations=64
3d/solver/contact_max_separation=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
